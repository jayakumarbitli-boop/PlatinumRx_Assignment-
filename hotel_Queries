-- 1. Last booked room per user
SELECT b.user_id, b.room_no
FROM bookings b
JOIN (
    SELECT user_id, MAX(booking_date) AS last_date
    FROM bookings
    GROUP BY user_id
) t
ON b.user_id = t.user_id AND b.booking_date = t.last_date;

-- 2. Billing in Nov 2021
SELECT 
    bc.booking_id,
    SUM(bc.item_quantity * i.item_rate) AS total_amount
FROM booking_commercials bc
JOIN items i ON bc.item_id = i.item_id
WHERE bc.bill_date BETWEEN '2021-11-01' AND '2021-11-30'
GROUP BY bc.booking_id;

-- 3. Bills > 1000 in Oct 2021
SELECT 
    bc.bill_id,
    SUM(bc.item_quantity * i.item_rate) AS bill_amount
FROM booking_commercials bc
JOIN items i ON bc.item_id = i.item_id
WHERE bc.bill_date BETWEEN '2021-10-01' AND '2021-10-31'
GROUP BY bc.bill_id
HAVING SUM(bc.item_quantity * i.item_rate) > 1000;

-- 4. Most & least ordered items
WITH cte AS (
    SELECT 
        DATE_FORMAT(bc.bill_date, '%Y-%m') AS month,
        bc.item_id,
        SUM(bc.item_quantity) AS qty
    FROM booking_commercials bc
    GROUP BY month, bc.item_id
),
rnk AS (
    SELECT *,
        RANK() OVER (PARTITION BY month ORDER BY qty DESC) AS r1,
        RANK() OVER (PARTITION BY month ORDER BY qty ASC) AS r2
    FROM cte
)
SELECT * FROM rnk WHERE r1=1 OR r2=1;

-- 5. Second highest bill per month
WITH bill AS (
    SELECT 
        bc.bill_id,
        b.user_id,
        DATE_FORMAT(bc.bill_date, '%Y-%m') AS month,
        SUM(bc.item_quantity * i.item_rate) AS amount
    FROM booking_commercials bc
    JOIN bookings b ON bc.booking_id = b.booking_id
    JOIN items i ON bc.item_id = i.item_id
    GROUP BY bc.bill_id, b.user_id, month
),
rnk AS (
    SELECT *,
        DENSE_RANK() OVER (PARTITION BY month ORDER BY amount DESC) AS rnk
    FROM bill
)
SELECT * FROM rnk WHERE rnk = 2;
